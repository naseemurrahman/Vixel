# Vixel — environment defaults (copy to .env and adjust)
VIXEL_PORT=8080
VIXEL_HOST=0.0.0.0
VIXEL_DATA_DIR=./data
VIXEL_RECORDINGS_DIR=./recordings
VIXEL_JWT_SECRET=<generate-a-random-value-of-at-least-32-characters>
VIXEL_LICENSE_PUBLIC_KEY=
VIXEL_ADMIN_USER=admin
VIXEL_ADMIN_PASSWORD=<set-a-strong-password-of-at-least-32-characters>
VIXEL_CORS_ORIGIN=http://localhost:5173
